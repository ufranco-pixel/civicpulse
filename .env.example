# =============================================================================
# Análisis de Sentimientos · configuración de despliegue
#
#   cp .env.example .env    y edite los valores marcados con «CAMBIAR».
#
# Este archivo alimenta a docker-compose. Cada servicio tiene además su propio
# .env.example con el detalle de sus variables internas.
#
# NUNCA versione el .env resultante.
# =============================================================================

# ── Identidad del despliegue ────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=oeste-sentimientos
NODE_ENV=production
LOG_LEVEL=info

# ── Base de datos EXTERNA ───────────────────────────────────────────────────
# Este proyecto NO levanta PostgreSQL: se conecta al que usted ya tiene.
#
# Hacen falta las dos formas de la misma cadena. Los servicios Node usan `pg`
# (driver síncrono) y sentiment-api usa asyncpg; el prefijo cambia y una URL
# con «+asyncpg» rompe a los Node, así que no se pueden unificar.

DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:5432/BASE?sslmode=require
DATABASE_URL_ASYNC=postgresql+asyncpg://USUARIO:PASSWORD@HOST:5432/BASE

# asyncpg NO entiende el parámetro sslmode en la URL: lanza «unexpected keyword
# argument». Por eso DATABASE_URL_ASYNC va SIN sslmode y el TLS se activa con
# esta bandera, que sentiment-api traduce a los argumentos del driver.
DATABASE_SSL=true

# Notas de conexión:
#  · Si la base corre en su propia máquina, el host desde dentro de un
#    contenedor NO es localhost sino host.docker.internal (ya está mapeado).
#  · Casi todas las bases gestionadas exigen sslmode=require.
#  · El usuario NO debe ser superusuario: PostgreSQL no aplica RLS a los
#    superusuarios y el aislamiento entre organizaciones quedaría anulado.
#    db-preflight lo comprueba y avisa.

# Verificación del certificado del servidor.
#   false → cifra el tráfico pero no valida la cadena. Es lo que funciona sin
#           más con RDS, Neon, Supabase y compañía, y equivale a sslmode=require.
#           Protege contra escucha pasiva, no contra suplantación.
#   true  → exige un certificado verificable. Necesita la CA del proveedor en
#           DATABASE_SSL_ROOT_CERT (montada dentro del contenedor).
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_SSL_ROOT_CERT=

# ── Pool de conexiones ──────────────────────────────────────────────────────
# Con una base externa el pool ya no es local: cada servicio abre su propio
# grupo de conexiones. El total es DB_POOL_SIZE × (nº de servicios × réplicas),
# y debe caber en max_connections del servidor menos lo que consuma el resto.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Recicla las conexiones antes de que las corte el balanceador o el NAT del
# proveedor (normalmente a los 3600 s).
DB_POOL_RECYCLE_SEC=1800
DB_STATEMENT_TIMEOUT_MS=15000

# El esquema ya instalado no se toca. Póngalo en true sólo si quiere que el
# arranque lo instale por usted en una base vacía.
DB_AUTO_INSTALL=false
# Reintentos de conexión al arrancar (2 s cada uno).
DB_WAIT_ATTEMPTS=30

# ── Ajuste de servidor que este esquema necesita ────────────────────────────
# max_locks_per_transaction >= 256
#
# El esquema crea ~1900 particiones mensuales. Con el valor por defecto (64),
# una consulta que abarque muchos meses, un REFRESH MATERIALIZED VIEW o un
# VACUUM sobre la tabla padre agotan la tabla de locks y abortan con
# «out of shared memory». Requiere reinicio de la instancia.
#
#   Autoalojado : ALTER SYSTEM SET max_locks_per_transaction = 256;
#   RDS / Aurora: parameter group
#   Neon, Supabase y similares: panel de configuración o soporte
#
# db-preflight lo verifica en cada arranque y avisa si se quedó corto.

# Pepper de seudonimización de autores. Cadena larga y aleatoria.
# Sin esto los hashes de autor son vulnerables a fuerza bruta: el espacio de
# identificadores de una red social es pequeño y se recorre en minutos.
#   openssl rand -hex 32
#
# db-preflight intenta persistirlo con ALTER DATABASE y, si su proveedor no lo
# permite, con ALTER ROLE … IN DATABASE. Si ninguna funciona, lo avisa.
#
# NO LO CAMBIE una vez que haya datos: los hashes existentes dejarían de
# coincidir con los nuevos y el conteo de autores únicos se duplicaría.
CIVICPULSE_AUTHOR_PEPPER=CAMBIAR_generar_con_openssl_rand_hex_32

# ── Keycloak ────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CAMBIAR_password_keycloak
KEYCLOAK_PORT=8080
KC_URL=http://keycloak:8080
# URL pública, la que ve el navegador. En producción es el dominio real.
KC_PUBLIC_URL=http://localhost:8080
KC_REALM=civicpulse
KC_CLIENT_ID=civicpulse-frontend
KC_AUDIENCE=account

OIDC_ISSUER=http://keycloak:8080/realms/civicpulse
OIDC_JWKS_URI=http://keycloak:8080/realms/civicpulse/protocol/openid-connect/certs
AUTH_ORG_CLAIM=organization_id
AUTH_ROLES_CLIENT=civicpulse-frontend

# ── Puertos publicados ──────────────────────────────────────────────────────
FRONTEND_PORT=8090
SENTIMENT_API_PORT=8000
WHATSAPP_BOT_PORT=8001
REPORTS_API_PORT=8002
ALERTS_API_PORT=8003

# ── CORS ────────────────────────────────────────────────────────────────────
# Lista separada por comas de los orígenes del frontend. Sin comodines.
CORS_ORIGINS=http://localhost:8090

# ── Motor de alertas ────────────────────────────────────────────────────────
# El evaluador vive en la base de datos (civic.evaluate_alert_rules); alerts-api
# sólo lo invoca. Con varias réplicas, un advisory lock garantiza que evalúe una.
ALERT_EVAL_ENABLED=true
ALERT_EVAL_INTERVAL_SEC=60
ALERT_EVAL_LOCK_KEY=918273645

# ── Clasificador LLM · Google Gemini ────────────────────────────────────────
# Déjelo en false hasta haber evaluado y promovido una versión de prompt.
CLASSIFIER_ENABLED=false
LLM_PROVIDER=gemini

# Clave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=CAMBIAR_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# v1beta es la única versión con responseMimeType y responseSchema, que son
# lo que fuerza la salida JSON. Con v1 la tasa de esquema válido se desploma.
GEMINI_API_VERSION=v1beta

# Umbral de los filtros de seguridad de Gemini.
#   BLOCK_NONE | BLOCK_ONLY_HIGH | BLOCK_MEDIUM_AND_ABOVE | BLOCK_LOW_AND_ABOVE
#
# Con el umbral por defecto, Gemini rechaza analizar insultos, amenazas y
# discurso de odio: justo los contenidos que este sistema necesita detectar y
# etiquetar. Esos comentarios se perderían en silencio y el tablero quedaría
# desplazado hacia lo positivo, que es peor que no medirlos.
# BLOCK_NONE no genera contenido dañino: sólo permite CLASIFICARLO.
GEMINI_SAFETY_THRESHOLD=BLOCK_NONE

LLM_TIMEOUT_MS=30000

# Contenidos por corrida del clasificador (equivale a su EVENTS_POST_LIMIT).
CLASSIFIER_BATCH_LIMIT=30
# Confianza mínima por defecto. civic.campaign_pipeline.min_confidence la
# sobrescribe por campaña y tarea, y tiene prioridad sobre esta.
CLASSIFIER_MIN_CONFIDENCE=0.6

# Respaldo en un proveedor DISTINTO: uno en la misma API cae junto con ella.
# Opcional; si se deja vacío no hay reintento con otro modelo.
LLM_API_KEY_REF=

# ── WhatsApp ────────────────────────────────────────────────────────────────
# El bot atiende a una sola organización: quien le escribe no trae token, así
# que no hay claim del que deducirla.
WA_ORGANIZATION_ID=
WA_DEFAULT_CAMPAIGN_CODE=
WA_AUTOSTART=true
WA_SESSION_PATH=/app/wa-session

# ── Informes ────────────────────────────────────────────────────────────────
REPORTS_STORAGE_DIR=/app/generated
REPORTS_RETENTION_DAYS=30

# ── Marca (se inyectan en el build del frontend) ────────────────────────────
VITE_BRAND_NAME=Mi Organización
VITE_BRAND_SHORT_NAME=MiOrg
VITE_BRAND_PRODUCT_NAME=Análisis de Sentimientos
VITE_BRAND_TAGLINE=Escucha de la conversación pública
VITE_BRAND_PRIMARY_COLOR=#1F5FA8
VITE_BRAND_ACCENT_COLOR=#E0A22C
VITE_BRAND_SUPPORT_EMAIL=soporte@ejemplo.mx
VITE_BRAND_COPYRIGHT=© 2026 Mi Organización

# URLs públicas de las APIs, las que usa el navegador.
VITE_SENTIMENT_API_URL=http://localhost:8000
VITE_SENTIMENT_API_PREFIX=/v1
VITE_ALERTS_API_URL=http://localhost:8003
VITE_REPORTS_API_URL=http://localhost:8002
VITE_WHATSAPP_API_URL=http://localhost:8001
VITE_API_TIMEOUT_MS=30000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=oeste-sentimientos
VITE_KEYCLOAK_CLIENT_ID=civicpulse-frontend
VITE_AUTH_DISABLED=false
