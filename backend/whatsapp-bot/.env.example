# =============================================================================
# Análisis de Sentimientos · whatsapp-bot (8001)
# Copie a .env y ajuste.
# =============================================================================

# ── Servicio ────────────────────────────────────────────────────────────────
SERVICE_NAME=whatsapp-bot
NODE_ENV=production
PORT=8001
# debug | info | warn | error   (default: info)
LOG_LEVEL=info
# Cabecera de la que se toma el id de petición si el proxy ya lo generó.
REQUEST_ID_HEADER=x-request-id
JSON_BODY_LIMIT=128kb
SHUTDOWN_TIMEOUT_MS=20000

# ── Base de datos ───────────────────────────────────────────────────────────
# Rol recomendado: civicpulse_app (tiene RLS activa; el contexto se fija por
# transacción con civic_ops.set_session_context).
DATABASE_URL=postgres://civicpulse_app:cambieme@localhost:5432/oeste-sentimientos
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ── Autenticación (Keycloak / OIDC, RS256 vía JWKS) ────────────────────────
OIDC_ISSUER=https://auth.example.org/realms/civicpulse
# Si se omite se deriva de OIDC_ISSUER + /protocol/openid-connect/certs
OIDC_JWKS_URI=
OIDC_AUDIENCE=oeste-sentimientos-api
AUTH_ORG_CLAIM=organization_id
AUTH_ROLES_CLIENT=oeste-sentimientos-api
AUTH_CLOCK_TOLERANCE_SEC=5
JWKS_CACHE_MAX_ENTRIES=5
JWKS_CACHE_MAX_AGE_MS=600000
JWKS_RATE_LIMIT_PER_MIN=10

# ── CORS (lista blanca explícita, separada por comas) ──────────────────────
CORS_ORIGINS=https://tablero.example.org,http://localhost:5173

# ── Sesión de WhatsApp ──────────────────────────────────────────────────────
# Directorio de LocalAuth. DEBE ser un volumen persistente: sin él hay que
# escanear el QR en cada despliegue y el canal se cae en cada reinicio.
WA_SESSION_PATH=/var/lib/oeste-sentimientos/wa-session
# Identificador de la sesión dentro de ese directorio.
WA_CLIENT_ID=oeste-sentimientos
# false para no inicializar WhatsApp al arrancar (útil en pruebas y en la
# réplica que sólo sirve la API). Se inicia luego con POST /bot/reconnect.
WA_AUTOSTART=true
# Imprime el QR en la salida del contenedor además de exponerlo en /bot/status.
WA_PRINT_QR_TERMINAL=true
# Reintentos de vinculación con espera exponencial (base → tope).
WA_MAX_INIT_RETRIES=8
WA_RETRY_BASE_MS=5000
WA_RETRY_MAX_MS=300000

# Chromium del sistema. En la imagen ya vienen fijadas; aquí para ejecución local.
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ── Comandos entrantes ──────────────────────────────────────────────────────
# Quien escribe al bot NO trae token, así que no hay claim del que sacar la
# organización: el proceso sirve a UNA. Sin este valor, los comandos que leen
# datos (!resumen, !baja) responden que el bot no está enlazado.
WA_ORGANIZATION_ID=
# Campaña que asume !resumen cuando no se indica código.
WA_DEFAULT_CAMPAIGN_CODE=
# Días que abarca el resumen de !resumen.
WA_DIGEST_DAYS=7
