# =============================================================================
# Análisis de Sentimientos · reports-api (8002)
# =============================================================================

# ── Servicio ────────────────────────────────────────────────────────────────
SERVICE_NAME=reports-api
NODE_ENV=production
PORT=8002
LOG_LEVEL=info
REQUEST_ID_HEADER=x-request-id

# ── Base de datos ───────────────────────────────────────────────────────────
DATABASE_URL=postgres://civicpulse_app:cambieme@localhost:5432/oeste-sentimientos
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
# Un informe agrega 30 días de datos: necesita más margen que una consulta del
# tablero. 60 s es holgado; si se supera, el problema son los índices.
DATABASE_STATEMENT_TIMEOUT_MS=60000

# ── Autenticación (Keycloak / OIDC, RS256 vía JWKS) ────────────────────────
OIDC_ISSUER=https://auth.example.org/realms/civicpulse
OIDC_JWKS_URI=
OIDC_AUDIENCE=oeste-sentimientos-api
AUTH_ORG_CLAIM=organization_id
AUTH_ROLES_CLIENT=oeste-sentimientos-api
AUTH_CLOCK_TOLERANCE_SEC=5
JWKS_CACHE_MAX_ENTRIES=5
JWKS_CACHE_MAX_AGE_MS=600000
JWKS_RATE_LIMIT_PER_MIN=10

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://tablero.example.org,http://localhost:5173

# ── Generación de informes ──────────────────────────────────────────────────
# Directorio donde se depositan los PDF ya generados.
#
# El ESTADO del trabajo vive en civic.analysis_jobs (PostgreSQL); en disco sólo
# queda el binario. El esquema no tiene tabla para adjuntos y meter varios MB
# de bytea en analysis_jobs infla una tabla que se consulta constantemente.
# En producción monte aquí un volumen persistente o sustitúyalo por S3.
REPORTS_STORAGE_DIR=/var/lib/oeste-sentimientos/reports
# Días que se conserva el PDF antes de que la limpieza lo borre. El registro
# del trabajo en la base permanece.
REPORTS_RETENTION_DAYS=90
REPORTS_CLEANUP_INTERVAL_HOURS=12
# Trabajos que se generan a la vez en un mismo proceso. Cada uno agrega varios
# días de datos; más paralelismo satura el pool antes que la CPU.
REPORTS_MAX_CONCURRENT=2
# Tope de periodo solicitable, en días.
REPORTS_MAX_PERIOD_DAYS=365
