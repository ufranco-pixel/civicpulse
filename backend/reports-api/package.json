{
  "name": "@civicpulse/reports-api",
  "version": "1.0.0",
  "private": true,
  "description": "CivicPulse · API de informes: genera PDF de campaña con datos leídos de la base, nunca recibidos del cliente.",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
