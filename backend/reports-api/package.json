  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "jwks-rsa": "3.1.0",
    "pdfkit": "0.15.0",
    "pg": "8.12.0",
    "zod": "3.23.8"
  },
  "devDependencies": {}
}
