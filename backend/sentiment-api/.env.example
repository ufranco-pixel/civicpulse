# =============================================================================
# Análisis de Sentimientos · sentiment-api (8000)
# Copie a .env y ajuste. Todas las variables las lee app/core/config.py.
# Los nombres son sensibles a mayúsculas (case_sensitive=True).
# =============================================================================

# ── Base de datos ───────────────────────────────────────────────────────────
# DSN asíncrono. DEBE empezar con postgresql+asyncpg:// o la configuración
# falla al construirse: con el driver síncrono el servicio bloquearía el bucle
# de eventos en la primera consulta.
# Rol recomendado: civicpulse_app (con RLS; el contexto se fija por transacción).
DATABASE_URL=postgresql+asyncpg://civicpulse_app:cambieme@localhost:5432/oeste-sentimientos
# Conexiones permanentes del pool (1-100).
POOL_SIZE=10
# Conexiones extra por encima de POOL_SIZE en picos (0-100).
MAX_OVERFLOW=5
# statement_timeout fijado en la conexión. Única defensa real contra una
# consulta sin poda de particiones que bloquee el pool. Mínimo 1000.
STATEMENT_TIMEOUT_MS=15000

# ── Identidad (Keycloak) ────────────────────────────────────────────────────
KC_URL=https://auth.example.org
KC_REALM=civicpulse
# Claim `aud` esperado. Vacío desactiva la verificación de audiencia.
KC_AUDIENCE=oeste-sentimientos-api

# ── Servicio HTTP ───────────────────────────────────────────────────────────
# Prefijo de versión. Se normaliza a "/algo" sin barra final. "/" = sin prefijo.
API_PREFIX=/v1
PORT=8000
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Orígenes permitidos, separados por coma. '*' sólo en desarrollo.
CORS_ORIGINS=https://tablero.example.org,http://localhost:5173

# ── Desarrollo ──────────────────────────────────────────────────────────────
# Con AUTH_DISABLED=true se inyecta un usuario ficticio con todos los roles y
# la organización DEV_ORG_ID. El arranque lo registra a nivel ERROR.
# NUNCA en producción: equivale a publicar los datos de esa organización.
AUTH_DISABLED=false
DEV_ORG_ID=00000000-0000-0000-0000-000000000000

# ── Clasificador LLM · Google Gemini ────────────────────────────────────────
CLASSIFIER_ENABLED=false
# gemini | openai | anthropic
LLM_PROVIDER=gemini

# Clave de Google AI Studio: https://aistudio.google.com/apikey
# Para Gemini se lee directamente de aquí; no hace falta LLM_API_KEY_REF.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# v1beta es la única versión con responseMimeType y responseSchema. Con v1 no
# se puede forzar salida JSON y schema_valid_rate cae por debajo del umbral de
# promoción (0.98).
GEMINI_API_VERSION=v1beta

# BLOCK_NONE | BLOCK_ONLY_HIGH | BLOCK_MEDIUM_AND_ABOVE | BLOCK_LOW_AND_ABOVE
#
# Con el umbral por defecto Gemini se niega a procesar insultos, amenazas y
# discurso de odio, que son precisamente los contenidos que este sistema debe
# detectar. El clasificador trata ese bloqueo como error explícito (no lo
# ignora), pero con BLOCK_NONE simplemente no ocurre: el modelo no genera
# contenido dañino, sólo lo CLASIFICA.
GEMINI_SAFETY_THRESHOLD=BLOCK_NONE

LLM_TIMEOUT_MS=30000

# Contenidos que toma cada corrida del clasificador.
CLASSIFIER_BATCH_LIMIT=30
# Confianza mínima por defecto. La sobrescribe, por campaña y tarea,
# civic.campaign_pipeline.min_confidence, que tiene prioridad.
CLASSIFIER_MIN_CONFIDENCE=0.6

# Sólo para el modelo de RESPALDO (otro proveedor). REFERENCIA al secreto, no
# el secreto: en despliegue vault://ruta/a/la/clave; en local admite el literal.
LLM_API_KEY_REF=
LLM_MODEL=gemini-flash-lite-latest
LLM_BASE_URL=
