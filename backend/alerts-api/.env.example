# =============================================================================
# CivicPulse · alerts-api (8003)
# Copie a .env y ajuste. Ninguna variable trae valor por defecto en producción
# salvo las marcadas con "default".
# =============================================================================

# ── Servicio ────────────────────────────────────────────────────────────────
SERVICE_NAME=alerts-api
NODE_ENV=production
PORT=8003
# debug | info | warn | error   (default: info)
LOG_LEVEL=info
# Cabecera de la que se toma el id de petición si el proxy ya lo generó.
REQUEST_ID_HEADER=x-request-id

# ── Base de datos ───────────────────────────────────────────────────────────
# Rol recomendado: civicpulse_app (tiene RLS activa; el contexto se fija por
# transacción con civic_ops.set_session_context).
DATABASE_URL=postgres://civicpulse_app:cambieme@localhost:5432/civicpulse
DATABASE_SSL=false
# Tamaño del pool. Recuerde que cada cliente SSE NO consume conexión: el
# stream se mantiene en memoria, no en una transacción abierta.
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
# Corta consultas colgadas del lado del servidor (ms). 0 = sin límite.
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ── Autenticación (Keycloak / OIDC, RS256 vía JWKS) ────────────────────────
OIDC_ISSUER=https://auth.example.org/realms/civicpulse
# Si se omite se deriva de OIDC_ISSUER + /protocol/openid-connect/certs
OIDC_JWKS_URI=
# Audiencia esperada. Vacío = no se valida audiencia (no recomendado).
OIDC_AUDIENCE=civicpulse-api
# Claim del que se lee el UUID de organización. Debe existir en el token.
AUTH_ORG_CLAIM=organization_id
# Cliente cuyos resource_access.<client>.roles se suman a los realm_access.
AUTH_ROLES_CLIENT=civicpulse-api
# Tolerancia de reloj en segundos (default: 5)
AUTH_CLOCK_TOLERANCE_SEC=5
# Caché de JWKS
JWKS_CACHE_MAX_ENTRIES=5
JWKS_CACHE_MAX_AGE_MS=600000
JWKS_RATE_LIMIT_PER_MIN=10

# ── CORS (lista blanca explícita, separada por comas) ──────────────────────
CORS_ORIGINS=https://tablero.example.org,http://localhost:5173

# ── SSE ─────────────────────────────────────────────────────────────────────
# Latido para que proxies y balanceadores no cierren la conexión (ms).
SSE_HEARTBEAT_MS=25000
# Valor del campo retry: que se envía al abrir el stream (ms).
SSE_RETRY_MS=5000
# Tope de clientes simultáneos por proceso. Protege la memoria.
SSE_MAX_CLIENTS=500

# ── Planificador de reglas ──────────────────────────────────────────────────
ALERT_EVAL_ENABLED=true
# Cada cuántos segundos se invoca civic.evaluate_alert_rules (default: 60)
ALERT_EVAL_INTERVAL_SEC=60
# Clave del pg_try_advisory_lock. Con varias réplicas sólo una evalúa.
ALERT_EVAL_LOCK_KEY=880311
# Segundos de espera antes de la primera corrida (deja arrancar al proceso).
ALERT_EVAL_INITIAL_DELAY_SEC=15
#
# Enumeración de campañas activas. Dos modos:
#  1) Lista explícita de organizaciones: cada una se recorre con su propio
#     contexto RLS usando el rol de aplicación. Es el modo recomendado.
#     ALERT_EVAL_ORG_IDS=uuid-org-1,uuid-org-2
#  2) Si la lista está vacía se usa SCHEDULER_DATABASE_URL, cuyo rol debe
#     tener BYPASSRLS (civicpulse_owner) para poder listar las campañas de
#     todas las organizaciones. La evaluación en sí siempre se hace después
#     con el contexto de organización correcto.
ALERT_EVAL_ORG_IDS=
SCHEDULER_DATABASE_URL=
