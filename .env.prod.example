# =============================================================================
# Análisis de Sentimientos · PRODUCCIÓN — oeste.mx
#
#   cp .env.prod.example .env
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Ya viene rellenado con los valores de su infraestructura (web-network,
# websecure, myresolver, auth.oeste.mx, la base en 172.31.46.37).
#
# LO ÚNICO QUE TIENE QUE CAMBIAR:
#   · APP_DOMAIN         → el subdominio que quiera
#   · DB_PASSWORD        → dentro de las dos DATABASE_URL
#   · CIVICPULSE_AUTHOR_PEPPER
#   · GEMINI_API_KEY
#
# NUNCA versione el .env resultante.
# =============================================================================

COMPOSE_PROJECT_NAME=oeste-sentimientos
NODE_ENV=production
LOG_LEVEL=info
IMAGE_TAG=1.0.0


# =============================================================================
# 1 · DOMINIO  ← lo único imprescindible de cambiar
# =============================================================================
# Un solo dominio con rutas por prefijo:
#   https://APP_DOMAIN/          frontend
#   https://APP_DOMAIN/api/      API principal
#   https://APP_DOMAIN/alerts/   alertas y stream SSE
#   https://APP_DOMAIN/reports/  informes
APP_DOMAIN=sentimientos.oeste.mx

# Su Keycloak, el mismo que usa ziba-calendario.
AUTH_DOMAIN=auth.oeste.mx

# Apunte el DNS de APP_DOMAIN al servidor de Traefik ANTES de levantar:
# Let's Encrypt valida por HTTP y, si no resuelve, entra en el límite de ACME.


# =============================================================================
# 2 · TRAEFIK  (valores tomados de su stack de ziba-calendar)
# =============================================================================
TRAEFIK_NETWORK=web-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=myresolver

# COMPRUEBE ESTO en su traefik.yml antes de desplegar:
#
#   entryPoints:
#     websecure:
#       transport:
#         respondingTimeouts:
#           writeTimeout: 0s     ← 0 = sin límite
#
# El tablero mantiene una conexión SSE abierta de forma indefinida. Si
# writeTimeout tiene un valor distinto de cero, Traefik corta el stream cada N
# segundos y el cliente reconecta en bucle: el indicador de «en vivo» parpadea
# sin parar y cada reconexión abre una consulta nueva contra la base.
# ziba-calendar no usa SSE, así que es probable que nadie lo haya revisado.


# =============================================================================
# 3 · BASE DE DATOS
# =============================================================================
# Mismo servidor que ziba (172.31.46.37), base propia: CREATE DATABASE oeste-sentimientos;
#
# Dos formas de la misma cadena: los servicios Node usan el driver síncrono y
# sentiment-api usa asyncpg. No se pueden unificar.
DATABASE_URL=postgresql://civicpulse_app:CAMBIAR_PASSWORD@172.31.46.37:5432/civicpulse
DATABASE_URL_ASYNC=postgresql+asyncpg://civicpulse_app:CAMBIAR_PASSWORD@172.31.46.37:5432/civicpulse

# IP privada dentro de la misma red: el tráfico no sale a internet, así que
# TLS es opcional. Póngalo en true si la base está en otra VPC o subred.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_SSL_ROOT_CERT=

# NO reutilice el usuario `admin` de ziba. Cree uno propio SIN privilegios:
#
#   CREATE DATABASE oeste-sentimientos;
#   CREATE ROLE civicpulse_app LOGIN NOSUPERUSER NOBYPASSRLS PASSWORD '…';
#   GRANT USAGE ON SCHEMA civic, civic_cat, civic_api, civic_kpi, civic_ops TO civicpulse_app;
#   GRANT SELECT ON ALL TABLES IN SCHEMA civic_api, civic_cat, civic_kpi TO civicpulse_app;
#   GRANT SELECT, INSERT, UPDATE ON ALL TABLES IN SCHEMA civic TO civicpulse_app;
#   GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA civic_kpi, civic_ops TO civicpulse_app;
#
# Razón: PostgreSQL NO aplica RLS a superusuarios. Con `admin` conectado, el
# aislamiento entre organizaciones queda anulado aunque las políticas estén
# activas, y cada cliente vería los datos de todos.

# Total de conexiones = DB_POOL_SIZE × servicios × réplicas. Con 3 servicios
# son 30 base + overflow. Verifique que caben junto a las de ziba en el
# max_connections del servidor.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SEC=1800
DB_STATEMENT_TIMEOUT_MS=15000
DB_WAIT_ATTEMPTS=30

# ── AJUSTE OBLIGATORIO EN 172.31.46.37 ──────────────────────────────────────
#   ALTER SYSTEM SET max_locks_per_transaction = 256;   -- y reiniciar
#
# El esquema crea ~1900 particiones mensuales. Con el valor por defecto (64),
# las consultas que abarcan muchos meses y el refresco de vistas fallan con
# «out of shared memory». Afecta a toda la instancia, así que revise que el
# aumento no perjudique a ziba (sube algo el consumo de memoria compartida:
# unos pocos MB).
# db-preflight lo verifica en cada arranque y avisa si se quedó corto.

# Pepper de seudonimización:  openssl rand -hex 32
# NO LO CAMBIE con datos ya cargados: los hashes dejarían de coincidir y el
# conteo de autores únicos se duplicaría en silencio.
CIVICPULSE_AUTHOR_PEPPER=CAMBIAR_openssl_rand_hex_32


# =============================================================================
# 4 · KEYCLOAK  (el suyo, en auth.oeste.mx)
# =============================================================================
# NO se levanta un Keycloak nuevo. Cree en el suyo un realm para este proyecto,
# igual que hizo con `ziba-calendario`:
#
#   Consola de auth.oeste.mx → Create realm → Import
#   → docs/keycloak/civicpulse-realm.json
#
# El realm importado trae los seis roles y el cliente público con PKCE S256.
# Ajuste en el cliente `civicpulse-frontend`:
#   Valid redirect URIs : https://sentimientos.oeste.mx/*
#   Web origins         : https://sentimientos.oeste.mx
#   Post logout URIs    : https://sentimientos.oeste.mx/*
#
# Y BORRE los tres usuarios demo antes de abrirlo.

KC_URL=https://auth.oeste.mx
KC_REALM=civicpulse
KC_CLIENT_ID=civicpulse-frontend
KC_AUDIENCE=account

OIDC_ISSUER=https://auth.oeste.mx/realms/civicpulse
OIDC_JWKS_URI=https://auth.oeste.mx/realms/civicpulse/protocol/openid-connect/certs
AUTH_ORG_CLAIM=organization_id
AUTH_ROLES_CLIENT=civicpulse-frontend

# CRÍTICO: cada usuario necesita el atributo `organization_id` con el UUID de
# su organización en civic.organizations. La API lo toma del token y con él
# fija el contexto de RLS. Sin ese atributo el usuario entra pero ve cero
# filas en todo — que es el comportamiento correcto ante una configuración
# incompleta, pero desconcierta si no se sabe.

# Si algún día quisiera un Keycloak dedicado a este proyecto:
#   docker compose -f docker-compose.prod.yml --profile keycloak up -d
# y rellene KC_DB_URL / KC_DB_USERNAME / KC_DB_PASSWORD / KEYCLOAK_ADMIN*.
KC_DB_URL=
KC_DB_USERNAME=
KC_DB_PASSWORD=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=


# =============================================================================
# 5 · CLASIFICADOR · Google Gemini
# =============================================================================
# ⚠ La clave de Gemini que usa ziba-calendar va como build arg del FRONTEND
#   (VITE_GEMINI_API_KEY), o sea que queda incrustada en el JavaScript que
#   descarga el navegador. Cualquiera que abra zibareservaciones.oeste.mx
#   puede extraerla y gastar su cuota. Conviene rotarla y moverla al backend.
#
#   Aquí NO ocurre: la clave sólo la conoce sentiment-api. El navegador nunca
#   habla con Gemini.
#
# Use una clave DISTINTA a la de ziba, para poder revocar una sin tumbar la otra.
GEMINI_API_KEY=CAMBIAR_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_VERSION=v1beta
GEMINI_SAFETY_THRESHOLD=BLOCK_NONE

# Déjelo en false hasta haber evaluado y promovido una versión de prompt.
CLASSIFIER_ENABLED=false
LLM_PROVIDER=gemini
LLM_TIMEOUT_MS=30000
LLM_API_KEY_REF=
CLASSIFIER_BATCH_LIMIT=30
CLASSIFIER_MIN_CONFIDENCE=0.6


# =============================================================================
# 6 · MOTOR DE ALERTAS
# =============================================================================
ALERT_EVAL_ENABLED=true
ALERT_EVAL_INTERVAL_SEC=60
ALERT_EVAL_LOCK_KEY=918273645
# Debe quedar por debajo del idleTimeout de su entrypoint websecure.
SSE_HEARTBEAT_MS=25000


# =============================================================================
# 7 · INFORMES Y WHATSAPP
# =============================================================================
REPORTS_RETENTION_DAYS=30


# ── Canal de WhatsApp ────────────────────────────────────────────────────────
# Guía completa en docs/WHATSAPP.md
#
# EMPIECE EN mock: registra el envío en el log sin escribirle a nadie. Cuando
# vea las entregas pasar a 'sent', cambie a wwebjs y vincule el QR.
WA_PROVIDER=mock
# Si se rellena, ignora WA_PROVIDER. Para forzar mock contra la base real.
# WA_OVERRIDE_PROVIDER=mock

WA_DISPATCH_ENABLED=true
WA_DISPATCH_INTERVAL_MS=10000
WA_DISPATCH_BATCH=10
WA_MAX_ATTEMPTS=5
WA_RETRY_BASE_MINUTES=1
WA_STUCK_MINUTES=5
WA_SEND_TIMEOUT_MS=30000

# whatsapp-web.js. La ruta DEBE ser un volumen persistente: si se pierde al
# reiniciar, hay que escanear el QR en cada despliegue.
WA_SESSION_PATH=/var/lib/oeste-sentimientos/wa-session
WA_CLIENT_ID=oeste-sentimientos
WA_PRINT_QR_TERMINAL=true

# Alternativas oficiales, si algún día deja wwebjs.
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v18.0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# CADA DESTINATARIO se da de alta en civic.alert_subscriptions CON
# consent_given_at. Sin suscriptores la alerta se crea y no sale ningún
# mensaje. Ver el paso 2 de docs/WHATSAPP.md.

# El bot no se expone en Traefik. Sólo con:  --profile whatsapp
WA_ORGANIZATION_ID=
WA_DEFAULT_CAMPAIGN_CODE=
WA_AUTOSTART=true


# =============================================================================
# 8 · MARCA  (build-time: cambiarla exige reconstruir el frontend)
# =============================================================================
VITE_BRAND_NAME=oeste
VITE_BRAND_SHORT_NAME=oeste
VITE_BRAND_PRODUCT_NAME=Análisis de Sentimientos
VITE_BRAND_TAGLINE=Escucha de la conversación pública
VITE_BRAND_PRIMARY_COLOR=#1F5FA8
VITE_BRAND_ACCENT_COLOR=#E0A22C
VITE_BRAND_SUPPORT_EMAIL=ufranco@oeste.mx
VITE_BRAND_COPYRIGHT=© 2026 oeste
VITE_API_TIMEOUT_MS=30000
