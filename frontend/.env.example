# ─────────────────────────────────────────────────────────────────────────────
# Análisis de Sentimientos · frontend
# Copie a .env.local y ajuste. Solo las variables VITE_* llegan al navegador:
# NO ponga aqui ningun secreto, el bundle es publico.
# ─────────────────────────────────────────────────────────────────────────────

# Puerto del servidor de desarrollo (lo lee vite.config.js, no el navegador).
PORT=5173

# ── Servicios ────────────────────────────────────────────────────────────────
# Origen de cada microservicio. Sin barra final.
VITE_SENTIMENT_API_URL=http://localhost:8000
# Prefijo de version de sentiment-api (API_PREFIX del backend).
VITE_SENTIMENT_API_PREFIX=/v1
VITE_ALERTS_API_URL=http://localhost:8003
VITE_REPORTS_API_URL=http://localhost:8004
VITE_WHATSAPP_API_URL=http://localhost:8005

# Tiempo maximo por peticion, en milisegundos.
VITE_API_TIMEOUT_MS=20000

# ── Identidad (Keycloak) ─────────────────────────────────────────────────────
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=oeste-sentimientos
VITE_KEYCLOAK_CLIENT_ID=civicpulse-frontend
# Segundos de margen con que se renueva el token antes de expirar.
VITE_TOKEN_MIN_VALIDITY=70
# true = arranca sin Keycloak con un usuario ficticio. SOLO desarrollo.
VITE_AUTH_DISABLED=false

# ── Tiempo real ──────────────────────────────────────────────────────────────
# Reconexion del stream SSE de alertas.
VITE_SSE_RETRY_BASE_MS=2000
VITE_SSE_RETRY_MAX_MS=60000
# Severidad minima que se suscribe por defecto: info, low, medium, high, critical
VITE_SSE_SEVERITY_MIN=

# ── Marca ────────────────────────────────────────────────────────────────────
VITE_BRAND_NAME=Análisis de Sentimientos
VITE_BRAND_SHORT_NAME=CP
VITE_BRAND_PRODUCT_NAME=Análisis de Sentimientos
VITE_BRAND_TAGLINE=Escucha de conversacion publica digital
VITE_BRAND_PRIMARY_COLOR=#1d4ed8
VITE_BRAND_ACCENT_COLOR=#d97706
VITE_BRAND_SUPPORT_EMAIL=soporte@oeste-sentimientos.mx
VITE_BRAND_COPYRIGHT=
VITE_BRAND_DISCLAIMER=Mide conversacion publica digital. No es una encuesta ni predice resultados electorales.
